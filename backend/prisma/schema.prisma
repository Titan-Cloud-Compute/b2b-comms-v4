// Prisma schema for the template enterprise backend.
// Kept models: User, AuditLog, SystemSetting, RegistrationToken.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
  engineType   = "library"
}

// Connection URL lives in prisma.config.ts (Prisma 7+ requirement).
datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum AuditActor {
  SYSTEM
  USER
  ADMIN
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  passwordHash  String?
  name      String?
  role      UserRole   @default(USER)
  // Backward-compat: the user's single "primary" model id.
  defaultLlmModelId String?
  // Model ENTITLEMENT copied from the redeemed registration token.
  grantedModelIds String[] @default([])
  // Chat-quota RESET EPOCH.
  quotaResetAt DateTime?
  auditLogs AuditLog[] @relation("AuditActor")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tokensCreated  RegistrationToken[] @relation("CreatedTokens")
  tokensConsumed RegistrationToken[] @relation("ConsumedTokens")
  passwordResetTokens PasswordResetToken[]
  password_hash  String?
  display_name  String?
  organization_id  String?
  active  Boolean?
  created_at  DateTime?
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id           String     @id @default(cuid())
  firmId       String?
  actor        AuditActor
  actorUserId  String?
  actorUser    User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  payloadJson  Json
  createdAt    DateTime   @default(now())

  @@index([actorUserId])
  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// System settings (runtime override of service credentials)
// ─────────────────────────────────────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Registration tokens (one-time admin-issued invite codes for signup)
// ─────────────────────────────────────────────────────────────────────────────

model RegistrationToken {
  token        String    @id
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation("CreatedTokens",  fields: [createdById],  references: [id], onDelete: SetNull)
  consumed     Boolean   @default(false)
  consumedAt   DateTime?
  consumedById String?
  consumedBy   User?     @relation("ConsumedTokens", fields: [consumedById], references: [id], onDelete: SetNull)
  firmId       String?
  role         String?
  expiresAt    DateTime?
  grantedModelIds String[] @default([])

  @@index([consumed])
}

// ─────────────────────────────────────────────────────────────────────────────
// Password reset tokens (single-use, short-lived, per OWASP guidance)
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumed   Boolean   @default(false)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Colossus managed accounts (seeded from COLOSSUS_ACCOUNTS_JSON)
// ─────────────────────────────────────────────────────────────────────────────

model ColossusAccount {
  id           String   @id @default(cuid())
  role         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  loginPath    String?  @map("login_path")
  createdBy    String   @default("colossus") @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("colossus_accounts")
}

model organizations {
  id  String  @id @default(cuid())
  name  String?
  type  String?
  is_internal  Boolean?
  created_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model invitations {
  id  String  @id @default(cuid())
  project_id  String?
  email  String?
  token_hash  String?
  status  String?
  invited_by  String?
  expires_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model projects {
  id  String  @id @default(cuid())
  organization_id  String?
  name  String?
  status  String?
  created_by  String?
  created_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model project_members {
  id  String  @id @default(cuid())
  project_id  String?
  user_id  String?
  added_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model folders {
  id  String  @id @default(cuid())
  project_id  String?
  parent_id  String?
  name  String?
  created_by  String?
  deleted_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model files {
  id  String  @id @default(cuid())
  project_id  String?
  folder_id  String?
  name  String?
  mime_type  String?
  current_version_id  String?
  deleted_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model file_versions {
  id  String  @id @default(cuid())
  file_id  String?
  version_number  Int?
  storage_key  String?
  size_bytes  BigInt?
  uploaded_by  String?
  uploaded_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model channels {
  id  String  @id @default(cuid())
  project_id  String?
  kind  String?
  name  String?
  internal_only  Boolean?
  status  String?
  created_by  String?
  created_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model question_resolutions {
  id  String  @id @default(cuid())
  channel_id  String?
  side  String?
  resolved_by  String?
  resolved_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model messages {
  id  String  @id @default(cuid())
  channel_id  String?
  author_id  String?
  body_html  String?
  edited_at  DateTime?
  deleted_at  DateTime?
  created_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model message_attachments {
  id  String  @id @default(cuid())
  message_id  String?
  file_id  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model references {
  id  String  @id @default(cuid())
  message_id  String? @unique
  file_version_id  String?
  page_number  Int?
  annotations  Json?
  author_id  String?
  updated_at  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model channel_read_state {
  id  String  @id @default(cuid())
  channel_id  String?
  user_id  String?
  last_read_message_id  String?
  unread_count  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
